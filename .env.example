# Copy to .env.local. Every value here is optional in development, and the
# site runs with none of them set.

# --------------------------------------------------------------------------
# SESSIONS
# --------------------------------------------------------------------------

# Signs the session cookie. REQUIRED in production, where the app refuses to
# start a session without it. Must be at least 32 characters: set but shorter
# is an error rather than being quietly ignored.
#
# In development one is generated and kept in data/.session-secret, so logins
# survive a restart.
#
#   openssl rand -base64 32
SESSION_SECRET=

# Whoever signs up with this address becomes the owner and sees every
# enquiry and order. Leave it unset and the FIRST account created becomes the
# owner, which the sign up page says out loud while it is still true.
OWNER_EMAIL=

# --------------------------------------------------------------------------
# STORAGE
# --------------------------------------------------------------------------

# Where the local JSON database lives. Relative to the project root, or an
# absolute path. Development only: it is ignored once Supabase is configured,
# and the app refuses to use it on Vercel, where each instance would get its
# own copy on a disk that is thrown away.
DATA_FILE=

# Run supabase/schema.sql in the Supabase SQL editor first. It is idempotent.
# Set BOTH of these or NEITHER: one without the other is refused at startup,
# because it means somebody intended to use Supabase and the site would
# otherwise quietly write real orders somewhere nobody is looking.
#
# The service-role key is server only and must never carry a NEXT_PUBLIC_
# prefix. It bypasses row level security by design, which is why the schema
# grants no policies to anybody else.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The public project key, used server side to start the Google sign in flow.
# Needed only for Google sign in; email and password login works without it.
SUPABASE_ANON_KEY=

# --------------------------------------------------------------------------
# THE SITE'S OWN URL
# --------------------------------------------------------------------------

# The canonical deployed URL, for example https://your-catering-site.vercel.app
#
# Used for the payment provider's return URLs, robots.txt and the sitemap:
# anywhere a link has to work outside the request that generated it. NOT taken
# from the incoming Host header, which a caller controls. On Vercel it falls
# back to VERCEL_URL, which is right for a preview and is the reason to set
# this explicitly for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# --------------------------------------------------------------------------
# PAYMENTS
# --------------------------------------------------------------------------

# Set both to offer online payment. With either missing the site works and
# orders are simply unpaid until settled some other way.
#
# Create a webhook at <your site>/api/stripe/webhook and subscribe it to:
#   checkout.session.completed
#   checkout.session.async_payment_succeeded   a delayed method that cleared
#   checkout.session.async_payment_failed
#   checkout.session.expired
#   payment_intent.payment_failed
#   charge.refunded
#
# Only the first two mark an order paid, and only after the amount and
# currency are checked against the stored order. The rest are recorded so the
# owner can see what happened.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --------------------------------------------------------------------------
# PRAXI
# --------------------------------------------------------------------------

# Both must be set or the site simply does not send anything; it runs
# perfectly well without them. With them set, new customers, orders, and
# enquiries are mirrored to Praxi as canonical events.
#
#   PRAXI_API_URL     the Praxi API, e.g. http://localhost:8787 locally
#   PRAXI_SECRET_KEY  an sk_ integration key for THIS business, minted with
#                     POST /v1/business/<id>/integration/keys
#
# This is the OUTWARD direction only. What Praxi may do TO this site is a
# separate credential entirely, minted and revoked at /admin/praxi, so
# switching one off does not touch the other.
PRAXI_API_URL=
PRAXI_SECRET_KEY=
