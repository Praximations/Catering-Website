# Copy to .env.local. Every value here is optional in development, and the
# site runs with none of them set.

# Signs the session cookie. REQUIRED in production, where the app refuses
# to start a session without it. In development one is generated and kept
# in data/.session-secret so logins survive a restart.
#   openssl rand -base64 32
SESSION_SECRET=

# Whoever signs up with this address becomes the owner and sees every
# enquiry. Leave it unset and the FIRST account created becomes the owner.
OWNER_EMAIL=

# Where the JSON database lives, relative to the project root.
# Defaults to data/catering.json.
DATA_FILE=

# PRAXI. Both must be set or the site simply does not send anything; it
# runs perfectly well without them. With them set, new customers, orders,
# and enquiries are mirrored to Praxi as canonical events.
#   PRAXI_API_URL   the Praxi API, e.g. http://localhost:8787 locally
#   PRAXI_SECRET_KEY  an sk_ integration key for THIS business, minted with
#                     POST /v1/business/<id>/integration/keys
PRAXI_API_URL=
PRAXI_SECRET_KEY=
